<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="400" viewBox="0 0 1200 400" role="img" aria-labelledby="title desc">
  <title id="title">Mohamed Elsayed, Full Stack Engineer</title>
  <desc id="desc">React.js, Node.js, NestJS and TypeScript. Building secure, scalable web products.</desc>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0B1117"/>
      <stop offset="1" stop-color="#070A0E"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.18" cy="0.1" r="0.7">
      <stop offset="0" stop-color="#2DD4BF" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#2DD4BF" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="0.95" cy="1" r="0.6">
      <stop offset="0" stop-color="#6366F1" stop-opacity="0.16"/>
      <stop offset="1" stop-color="#6366F1" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2DD4BF"/>
      <stop offset="1" stop-color="#818CF8"/>
    </linearGradient>
    <pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.1" fill="#FFFFFF" fill-opacity="0.05"/>
    </pattern>
    <clipPath id="card"><rect width="1200" height="400" rx="20"/></clipPath>
  </defs>
  <style>
    .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Helvetica, Arial, sans-serif; }
    .mono { font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, Consolas, monospace; }
    .rise { opacity: 0; animation: rise .8s cubic-bezier(.2,.7,.2,1) forwards; }
    .d1 { animation-delay: .1s; } .d2 { animation-delay: .25s; } .d3 { animation-delay: .4s; } .d4 { animation-delay: .55s; }
    .line { opacity: 0; animation: show .35s ease forwards; }
    .l1 { animation-delay: .9s; } .l2 { animation-delay: 1.3s; } .l3 { animation-delay: 1.9s; } .l4 { animation-delay: 2.3s; }
    .l5 { animation-delay: 2.9s; } .l6 { animation-delay: 3.3s; } .l7 { animation-delay: 3.9s; }
    .cursor { animation: blink 1.1s steps(1) infinite; }
    .pulse { animation: pulse 2.4s ease-in-out infinite; transform-origin: 72px 344px; }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    @keyframes show { to { opacity: 1; } }
    @keyframes blink { 50% { opacity: 0; } }
    @keyframes pulse { 0%, 100% { opacity: .35; transform: scale(1); } 50% { opacity: 0; transform: scale(2.4); } }
    @media (prefers-reduced-motion: reduce) { .rise, .line { opacity: 1; animation: none; } .cursor, .pulse { animation: none; } }
  </style>

  <g clip-path="url(#card)">
    <rect width="1200" height="400" fill="url(#bg)"/>
    <rect width="1200" height="400" fill="url(#dots)"/>
    <rect width="1200" height="400" fill="url(#glow)"/>
    <rect width="1200" height="400" fill="url(#glow2)"/>
  </g>
  <rect x=".5" y=".5" width="1199" height="399" rx="19.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.08"/>

  <!-- Identity -->
  <g class="sans">
    <text x="64" y="92" class="mono rise d1" font-size="14" letter-spacing="3" fill="#2DD4BF">FULL STACK ENGINEER</text>
    <text x="62" y="160" class="rise d2" font-size="58" font-weight="700" letter-spacing="-1.5" fill="#F5F7FA">Mohamed Elsayed</text>
    <rect x="64" y="182" width="88" height="3" rx="1.5" fill="url(#accent)" class="rise d2"/>
    <text x="64" y="226" class="rise d3" font-size="19" fill="#9AA6B2">Building secure, scalable web products,</text>
    <text x="64" y="254" class="rise d3" font-size="19" fill="#9AA6B2">from the React UI to the API behind it.</text>

    <g class="rise d4 mono" font-size="13">
      <rect x="64" y="284" width="92" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.04" stroke="#FFFFFF" stroke-opacity="0.1"/>
      <text x="110" y="304" text-anchor="middle" fill="#C9D1D9">React.js</text>
      <rect x="164" y="284" width="88" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.04" stroke="#FFFFFF" stroke-opacity="0.1"/>
      <text x="208" y="304" text-anchor="middle" fill="#C9D1D9">Node.js</text>
      <rect x="260" y="284" width="80" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.04" stroke="#FFFFFF" stroke-opacity="0.1"/>
      <text x="300" y="304" text-anchor="middle" fill="#C9D1D9">NestJS</text>
      <rect x="348" y="284" width="110" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.04" stroke="#FFFFFF" stroke-opacity="0.1"/>
      <text x="403" y="304" text-anchor="middle" fill="#C9D1D9">TypeScript</text>
      <rect x="466" y="284" width="110" height="30" rx="15" fill="#FFFFFF" fill-opacity="0.04" stroke="#FFFFFF" stroke-opacity="0.1"/>
      <text x="521" y="304" text-anchor="middle" fill="#C9D1D9">PostgreSQL</text>
    </g>

    <g class="rise d4">
      <circle cx="72" cy="344" r="5" fill="#2DD4BF" class="pulse"/>
      <circle cx="72" cy="344" r="4" fill="#2DD4BF"/>
      <text x="86" y="349" class="mono" font-size="13" fill="#7D8995">Cairo, Egypt · Open to remote roles</text>
    </g>
  </g>

  <!-- Terminal -->
  <g transform="translate(676 56)">
    <rect width="460" height="288" rx="14" fill="#0D1319" stroke="#FFFFFF" stroke-opacity="0.09"/>
    <path d="M0 14a14 14 0 0 1 14-14h432a14 14 0 0 1 14 14v26H0z" fill="#FFFFFF" fill-opacity="0.03"/>
    <line x1="0" y1="40" x2="460" y2="40" stroke="#FFFFFF" stroke-opacity="0.07"/>
    <circle cx="22" cy="20" r="5.5" fill="#FF5F57" fill-opacity=".85"/>
    <circle cx="40" cy="20" r="5.5" fill="#FEBC2E" fill-opacity=".85"/>
    <circle cx="58" cy="20" r="5.5" fill="#28C840" fill-opacity=".85"/>
    <text x="230" y="25" text-anchor="middle" class="mono" font-size="12" fill="#5C6773">~/mohamed — zsh</text>

    <g class="mono" font-size="14">
      <text x="22" y="76" class="line l1"><tspan fill="#2DD4BF">❯</tspan><tspan fill="#E6EDF3"> whoami</tspan></text>
      <text x="22" y="100" class="line l2" fill="#9AA6B2">full stack engineer · react + node</text>

      <text x="22" y="136" class="line l3"><tspan fill="#2DD4BF">❯</tspan><tspan fill="#E6EDF3"> cat now.txt</tspan></text>
      <text x="22" y="160" class="line l4" fill="#9AA6B2">cybersecurity web apps <tspan fill="#818CF8">@ RYVOR</tspan></text>
      <text x="22" y="182" class="line l4" fill="#9AA6B2">CRM &amp; e-commerce builds <tspan fill="#818CF8">@ HammerLoad</tspan></text>

      <text x="22" y="218" class="line l5"><tspan fill="#2DD4BF">❯</tspan><tspan fill="#E6EDF3"> git log --impact -1</tspan></text>
      <text x="22" y="242" class="line l6" fill="#9AA6B2">payments success <tspan fill="#E6EDF3">82% → 96%</tspan>, tickets <tspan fill="#E6EDF3">−40%</tspan></text>

      <text x="22" y="270" class="line l7"><tspan fill="#2DD4BF">❯</tspan></text>
      <rect x="38" y="258" width="9" height="16" fill="#2DD4BF" class="line l7"/>
      <rect x="38" y="258" width="9" height="16" fill="#0D1319" class="cursor"/>
    </g>
  </g>
</svg>
